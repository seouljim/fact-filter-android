<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 다른 앱(유튜브) 위에 투명 창을 띄우기 위한 권한 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 분석 서버 호출 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 유튜브 앱의 재생 정보를 조회할 수 있도록 선언 (Android 11 이상) -->
    <queries>
        <package android:name="com.google.android.youtube" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_view"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 유튜브의 "공유" 목록에 나타난다. 화면 없이 주소만 받아 넘기고 바로 닫힌다. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            알림 접근 권한을 받은 서비스만 다른 앱의 미디어 세션(재생 중인 제목·위치)을 읽을 수 있다.
            알림 내용 자체는 읽거나 저장하지 않는다.
        -->
        <service
            android:name=".MediaWatchService"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
